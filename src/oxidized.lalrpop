pub BaseTypeName: Type = { 
    "bool" => Type::Base(BaseType::Bool),
    "u32" => Type::Base(BaseType::U32), 
    "unit" => Type::Base(BaseType::Unit)
};

pub ConstantValue: Constant = { 
    "()" => Constant::Unit, 
    "true" => Constant::True, 
    "false" => Constant::False,
    <n: Number> => Constant::Number(n.to_string())
};

Number = r"[0-9]+";
Identifier = r"[a-zA-Z_]\w*";

pub Keyword = { Struct, Letrgn, OwnershipQualifier };
Struct = { "struct" }; 
Letrgn = { "letrgn" };
OwnershipQualifier = { "shrd", "uniq" };