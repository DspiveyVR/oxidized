---
ConcreteTyping { 
	r: [
		'x -> { shared x },
		'y -> { shared x },
		'z -> { shared y }
	]
 	𝜏: [
		 x := u32,
		 y := &'x shared u32,
		 z := &'y shared u32,
		 w := &'z shared &'x shared u32
	]
 }
