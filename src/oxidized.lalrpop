use crate::ast::*;

grammar;

pub Statements: Vec<Box<Expression>> = {
    <mut v:(<Expr> ";")*> <e:Expr?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

pub Expr: Box<Expression> = {
    #[precedence(level="0")]
    ConstantValue => Box::new(Expression::Constant(<>)),
    "(" <e: Expr> ")" => e,
    <i: Identifier> => Box::new(Expression::Variable(i.to_string())),
    #[precedence(level="1")] #[assoc(side="left")]
    <e: Expr> "." <n: Number> => match *e {
        Expression::PathAccess(exp, vect) => {
            let mut new_vec = vect.clone();
            new_vec.push(n.to_string());
            let new_path = Expression::PathAccess(exp.clone(), new_vec);
            Box::new(new_path)
        }
        _ => {
            let mut ex = Expression::PathAccess(e, vec![n.to_string()]);
            Box::new(ex)
        }
    },
    #[precedence(level="2")] #[assoc(side="right")]
    "*" <e: Expr> => Box::new(Expression::Deref(e)),
    #[precedence(level="3")] #[assoc(side="right")]
    "let" <i: Identifier> "=" <e: Expr> => Box::new(Expression::Let(i.to_string(), e)),
};

