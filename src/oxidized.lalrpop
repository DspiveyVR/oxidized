use crate::ast::*;

grammar;

pub Block: Block = {
    "letrgn" "<" <r: Regions> ">" "{" <s: TermList> "}" => Block::Letrgn(r, s),
    "{" <s: TermList> "}" => Block::EmptyBlock(s)
};

Regions: Vec<String> = {
    <mut v:("'" <Identifier> ",")*> <e:("'" <Identifier>)?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

TermList: Vec<Term> = {
    <t: Term> => vec![t],
    <mut v:TermList> <s:Term> => {
        v.push(s);
        v
    }
};

Term: Term = {
    <b: Block> => Term::Block(b),
    <s: Statement> => Term::Statement(s)
};

Statement: Statement = {
    "struct" <i: Identifier> "(" <fields: TypeList> ")" ";" => Statement::StructDeclaration(i, fields),
    <e: Expr> ";" => Statement::Expression(*e),
};

TypeList: Vec<Type> = {
    <mut v:(<BaseTypeName> ",")*> <e:BaseTypeName?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

Expr: Box<Expression> = {
    PrimaryExpression,
    UnaryExpression,
    PathAccess,
    "let" <m: "mut"?> <i: Identifier> "=" <r: (<ReferenceDeclaration>)?> <e: Expr> => 
        Box::new(Expression::Let(i, match m { None => false, Some(_) => true }, r, e)),
};

ExprCSV = Comma<Expr>;

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

PrimaryExpression: Box<Expression> = {
    ConstantValue => Box::new(Expression::Constant(<>)),
    "(" <e: Expr> ")" => e,
    <i: Identifier> => Box::new(Expression::Variable(i)),
};

UnaryExpression: Box<Expression> = {
    "*" <e: Expr> => Box::new(Expression::Deref(e)),
    <i: Identifier> "(" <csv: ExprCSV> ")" => Box::new(Expression::ConstructorCall(i, Box::new(Expression::CSV(csv))))
};

PathAccess: Box<Expression> = {
    <e: PrimaryExpression> "." <n: Number> => {
        let ex = Expression::PathAccess(e, vec![n]);
        Box::new(ex)
    },
    <e: PathAccess> "." <n: Number> => match *e {
        Expression::PathAccess(exp, vect) => {
            let mut new_vec = vect.clone();
            new_vec.push(n);
            let new_path = Expression::PathAccess(exp.clone(), new_vec);
            Box::new(new_path)
        }
        _ => { e }
    }
};

ReferenceDeclaration: ReferenceDeclaration = {
    "&" "'" <region: Identifier> <o: OwnershipQualifier> => ReferenceDeclaration(region, o)
};

OwnershipQualifier: OwnershipQualifier = { 
    "shrd" => OwnershipQualifier::Shrd, 
    "uniq" => OwnershipQualifier::Uniq
};

pub BaseTypeName: Type = { 
    "bool" => Type::Base(BaseType::Bool),
    "u32" => Type::Base(BaseType::U32), 
    "unit" => Type::Base(BaseType::Unit)
};

pub ConstantValue: Constant = { 
    "()" => Constant::Unit, 
    "true" => Constant::True, 
    "false" => Constant::False,
    <n: Number> => Constant::Number(n)
};

Number: u32 = {
    <s: r"[0-9]+"> => s.parse::<u32>().expect("Failed to parse integer")
};
Identifier: String = {
    <i: r"[a-zA-Z_]\w*"> => i.to_string()
};
