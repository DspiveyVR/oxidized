use crate::ast::*;

grammar;

pub Expr: Box<Expression> = {
    #[precedence(level="0")]
    ConstantValue => Box::new(Expression::Constant(<>)),
    LvalueBase,
    <e: LvalueBase> <p: Path> => Box::new(Expression::PathAccess(e, p)),
    #[precedence(level="1")] #[assoc(side="left")]
    "(" <csv: ExprCSV> ")" => Box::new(Expression::CSV(csv)),
    #[precedence(level="1")] #[assoc(side="right")]
    "*" <e: Expr> => Box::new(Expression::Deref(e)),
    <r: ReferenceAnnotation> <e: Expr> => Box::new(Expression::Ref(r, e)),
    #[precedence(level="2")] #[assoc(side="right")]
    "let" <m: "mut"?> <i: Identifier> ":" <typ: TypeAnnotation> "=" <e1: Expr> ";" <e2: Expr> => 
        Box::new(Expression::Let {
            name: i, 
            is_mut: match m { None => false, Some(_) => true }, 
            type_annotation: typ,
            e1: e1,
            e2: e2
        }),
    #[precedence(level="3")] #[assoc(side="left")]
    <e1: Expr> ";" <e2: Expr> => Box::new(Expression::Sequence(e1, e2)),
    #[precedence(level="2")] #[assoc(side="left")]
    "letrgn" "<" <regions: RegionCSV> ">" "{" <e: Expr> "}" => Box::new(Expression::Letrgn(regions, e)),
    "letrgn" "<" <region: RegionName> ">" "{" <e: Expr> "}" => Box::new(Expression::Letrgn(vec![region], e)),
};

LvalueBase: Box<Expression> = {
    <i: Identifier> => Box::new(Expression::Variable(i)),
    "(" <e: Expr> ")" => e
};

TypeAnnotation: TypeAnnotation = {
    <b: BaseTypeAnnotation> => TypeAnnotation::Base(b),
    <r: ReferenceAnnotation> <t: TypeAnnotation> => TypeAnnotation::Reference(r, Box::new(t)),
    "(" <types: Comma<TypeAnnotation>> ")" => TypeAnnotation::Tuple(types.into_iter().map(|t| Box::new(t)).collect())
};

ExprCSV = Comma<Expr>;
RegionCSV = Comma<RegionName>;

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")+> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

Path: Vec<u32> = {
    "." <n: Number>  => {
        vec![n]
    },
    <mut p: Path> "." <n: Number> => {
        p.push(n);
        p
    }
};

ReferenceAnnotation: ReferenceAnnotation = {
    "&" "'" <region: Identifier> <o: OwnershipQualifier> => ReferenceAnnotation(region, o)
};

OwnershipQualifier: OwnershipQualifier = { 
    "shrd" => OwnershipQualifier::Shrd, 
    "uniq" => OwnershipQualifier::Uniq
};

BaseTypeAnnotation: BaseTypeAnnotation = { 
    "bool" => BaseTypeAnnotation::Bool,
    "u32" => BaseTypeAnnotation::U32,
    "unit" => BaseTypeAnnotation::Unit
};

ConstantValue: Constant = { 
    "()" => Constant::Unit, 
    "true" => Constant::True, 
    "false" => Constant::False,
    <n: Number> => Constant::Number(n)
};

Number: u32 = {
    <s: r"[0-9]+"> => s.parse::<u32>().expect("Failed to parse integer")
};

RegionName: String = {
    "'" <i: Identifier> => i
};

Identifier: String = {
    <i: r"[a-zA-Z_]\w*"> => i.to_string()
};
